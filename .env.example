VITE_MARKET_PRICES_URL=https://script.google.com/macros/s/TU_SCRIPT_ID/exec
# Origen del Market Admin (sin /api/v1). Si se define, es la fuente exclusiva
# de productos: GET ${VITE_PANEL_API_URL}/api/v1/market-items
# Ejemplo: VITE_PANEL_API_URL=https://tu-admin.ejemplo.com
# Vacío = demo estático / Apps Script (si VITE_MARKET_PRICES_URL está set).
VITE_PANEL_API_URL=
# Webhook del CRM para leads del Market (opcional). También se activa en src/config/site.ts.
VITE_CRM_WEBHOOK_URL=
